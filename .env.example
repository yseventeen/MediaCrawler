# Proxy Configuration (Wandou HTTP)
# your_wandou_http_app_key
WANDOU_APP_KEY=

# Proxy Configuration (Kuaidaili)
# your_kuaidaili_secret_id
KDL_SECERT_ID=
# your_kuaidaili_signature
KDL_SIGNATURE=
# your_kuaidaili_username
KDL_USER_NAME=
# your_kuaidaili_password
KDL_USER_PWD=

# Proxy Configuration (Jisu HTTP)
# Get JiSu HTTP IP extraction key value
jisu_key=
# Get JiSu HTTP IP extraction encryption signature
jisu_crypto=

# ==================== Feishu (Lark) Bitable Sync ====================
# 同步 XHS 数据到飞书多维表格：suggestions（搜索建议）/ comments（评论）/ contents（笔记）三张表。
# 三张表可分别配置 table id，未配置的表不同步。列名在代码中写死，见 README 或下方说明。
# Note: Do NOT commit your real secrets into git.
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
# suggestions 表（关键词推荐/热词）。兼容旧配置：不填则用 FEISHU_BITABLE_TABLE_ID_SUGGESTIONS
FEISHU_BITABLE_TABLE_ID=
# FEISHU_BITABLE_TABLE_ID_SUGGESTIONS=
# comments 表（评论）
FEISHU_BITABLE_TABLE_ID_COMMENTS=
# contents 表（笔记/帖子）
FEISHU_BITABLE_TABLE_ID_CONTENTS=
# upsert = true 时按唯一键去重（suggestions 按 唯一键，comments 按 评论ID，contents 按 笔记ID）
FEISHU_UPSERT=true
